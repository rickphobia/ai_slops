# Copy to .env and adjust. The three secrets are required; every other value shown is the default,
# except COURT_BOOKER_SECURE_COOKIES, which is false here for local runs over plain http.

# Required. The Operator password as a hash; make it with `uv run court-booker hash-password`.
COURT_BOOKER_OPERATOR_PASSWORD_HASH=
# Required. Signs session cookies and CSRF tokens; at least 32 characters. Make one with
# `openssl rand -hex 32`. Changing it logs the Operator out.
COURT_BOOKER_SESSION_SECRET=
# Required. Encrypts the Profile in the database (a Fernet key: 32 random bytes, url-safe
# base64). Make one with `openssl rand -base64 32 | tr '+/' '-_'`. Keep a copy outside the
# server: without it the saved Profile can't be read and must be entered again.
COURT_BOOKER_PROFILE_KEY=

# DEBUG, INFO, WARNING or ERROR.
COURT_BOOKER_LOG_LEVEL=INFO
# Address and port the web server listens on. The Docker image sets the host to 0.0.0.0.
COURT_BOOKER_HOST=127.0.0.1
COURT_BOOKER_PORT=8000
# Public path prefix the host nginx serves the app under.
COURT_BOOKER_ROOT_PATH=/ai-projects/court-booker
# The SQLite file; its folder is created if missing. The Docker image uses /app/data/court-booker.sqlite3.
COURT_BOOKER_DATABASE_PATH=data/court-booker.sqlite3

# How many days a login lasts.
COURT_BOOKER_SESSION_DAYS=30
# true sends cookies over https only (the default, and right for the public site); false for
# http://127.0.0.1 while developing.
COURT_BOOKER_SECURE_COOKIES=false
# This many wrong passwords within the lockout minutes block every login for the lockout minutes.
COURT_BOOKER_LOGIN_MAX_FAILURES=5
COURT_BOOKER_LOGIN_LOCKOUT_MINUTES=15

# Booking Requests. The venue's timezone, as an IANA name: Release Times are midnight here and
# run times are shown in it.
COURT_BOOKER_VENUE_TIMEZONE=Asia/Kuala_Lumpur
# The Court's Slots as comma-separated HH:MM start times.
COURT_BOOKER_SLOTS=08:00,10:00,12:00,14:00,16:00,18:00,20:00
# How many days ahead Picktime opens a date: it opens at venue midnight this many days before.
COURT_BOOKER_BOOKING_WINDOW_DAYS=2
# A Booking Request runs a random moment this many seconds after its date's Release Time.
COURT_BOOKER_RUN_JITTER_MIN_SECONDS=60
COURT_BOOKER_RUN_JITTER_MAX_SECONDS=120
# A Booking Request for a date that is already open runs this many seconds after it is created.
COURT_BOOKER_OPEN_DATE_DELAY_SECONDS=60
# The public Picktime booking page and the Court's name as that page lists it.
COURT_BOOKER_PICKTIME_URL=https://www.picktime.com/f1bb4627-4b1b-483d-b746-4c34c8808d53
COURT_BOOKER_COURT_NAME=Badminton Hall 1
# How long each step on the Picktime page may take before the attempt counts as a network error.
COURT_BOOKER_PICKTIME_TIMEOUT_SECONDS=30
# Every booking attempt and dry run saves a screenshot here (it shows the Profile: keep it private).
# The Docker image uses /app/data/screenshots.
COURT_BOOKER_SCREENSHOT_DIR=data/screenshots
