# Copy to .env and adjust. The two secrets are required; every other value shown is the default,
# except COURT_BOOKER_SECURE_COOKIES, which is false here for local runs over plain http.

# Required. The Operator password as a hash; make it with `uv run court-booker hash-password`.
COURT_BOOKER_OPERATOR_PASSWORD_HASH=
# Required. Signs session cookies and CSRF tokens; at least 32 characters. Make one with
# `openssl rand -hex 32`. Changing it logs the Operator out.
COURT_BOOKER_SESSION_SECRET=

# DEBUG, INFO, WARNING or ERROR.
COURT_BOOKER_LOG_LEVEL=INFO
# Address and port the web server listens on. The Docker image sets the host to 0.0.0.0.
COURT_BOOKER_HOST=127.0.0.1
COURT_BOOKER_PORT=8000
# Public path prefix the host nginx serves the app under.
COURT_BOOKER_ROOT_PATH=/ai-projects/court-booker
# The SQLite file; its folder is created if missing. The Docker image uses /app/data/court-booker.sqlite3.
COURT_BOOKER_DATABASE_PATH=data/court-booker.sqlite3

# How many days a login lasts.
COURT_BOOKER_SESSION_DAYS=30
# true sends cookies over https only (the default, and right for the public site); false for
# http://127.0.0.1 while developing.
COURT_BOOKER_SECURE_COOKIES=false
# This many wrong passwords within the lockout minutes block every login until they age out.
COURT_BOOKER_LOGIN_MAX_FAILURES=5
COURT_BOOKER_LOGIN_LOCKOUT_MINUTES=15
